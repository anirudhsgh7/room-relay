{
  "name": "room-relay",
  "version": "0.5.0",
  "private": true,
  "description": "RoomRelay — a university room booking and access-management prototype.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/setup.ts",
    "db:reset": "tsx scripts/reset.ts && npm run db:setup",
    "predev": "npm run db:setup",
    "prestart": "npm run db:setup",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.13",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
