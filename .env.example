# ---------------------------------------------------------------------------
# RoomRelay local configuration
# Copy this file to `.env.local` and replace placeholder values.
# `npm run db:setup` will create a `.env.local` automatically for local use.
# ---------------------------------------------------------------------------

# Required. At least 32 characters. Generate a value with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ROOMRELAY_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional. The SQLite file used by the server. Relative paths resolve from the
# repository root. The directory is created automatically.
ROOMRELAY_DB_PATH=./data/room-relay.db

# Optional. IANA timezone used when RoomRelay displays campus-local dates.
# This must be a valid timezone identifier.
ROOMRELAY_CAMPUS_TIMEZONE=Europe/London
